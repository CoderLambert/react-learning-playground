{
  "name": "react-learning-playground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://CoderLambert.github.io/react-learning-playground/",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "demo:new": "node scripts/create-demo.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:content": "node --test tests/content-contract.test.mjs",
    "typecheck:samples": "npm exec --yes --package=typescript@7.0.2 -- tsc -p tsconfig.samples.json",
    "test:ai": "node --test tests/ai-code-block.test.mjs tests/ai-context-builder.test.mjs tests/ai-chat-client.test.mjs tests/ai-learning-assistant.test.mjs tests/ai-context-budgeting.test.mjs tests/ai-conversation-storage.test.mjs tests/ai-gateway-compaction-contract.test.mjs tests/ai-message-ux.test.mjs tests/ai-output-limit.test.mjs tests/deepseek-browser.test.mjs tests/source-citation.test.mjs worker/deepseek-assistant/test/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:mock": "VITE_AI_ASSISTANT_URL=http://127.0.0.1:4173/__ai-test__ npm run build && CI=true npm run test:e2e",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.1",
    "ajv": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "markstream-react": "^2.0.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.4.3",
    "stream-diffs": "^0.0.2",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.79.0",
    "rehype-slug": "^6.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "3.4.17",
    "vite": "^8.2.2"
  }
}
